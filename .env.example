# Looker API3 — never commit the real values. Copy to .env locally
# and set the same keys in Netlify Site settings → Environment variables.
LOOKER_BASE_URL=https://varsitytutors.looker.com
LOOKER_CLIENT_ID=
LOOKER_CLIENT_SECRET=
LOOKER_LOOK_ID=26564

# Optional. Peak uses the Overflow Configs High School list in
# src/data/overflowConfigsAllowlist.ts. A live table read needs a key that can
# SELECT overflow_allowlist (the publishable/anon key is not enough).
# SUPABASE_URL=https://xtvesnascwiecohvkstd.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Google Workspace domain(s) allowed to open the deployed site.
# ALLOWED_EMAIL_DOMAINS is checked by the Looker function (runtime).
# VITE_ALLOWED_EMAIL_DOMAINS is baked into the login wall at build time.
ALLOWED_EMAIL_DOMAINS=varsitytutors.com
VITE_ALLOWED_EMAIL_DOMAINS=varsitytutors.com
